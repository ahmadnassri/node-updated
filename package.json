{
  "version": "0.0.0-semantically-released",
  "name": "updated",
  "description": "check for updated package.json dependencies",
  "author": "Ahmad Nassri <ahmad@ahmadnassri.com> (https://www.ahmadnassri.com)",
  "homepage": "https://github.com/ahmadnassri/node-updated",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmadnassri/node-updated.git"
  },
  "bugs": {
    "url": "https://github.com/ahmadnassri/node-updated/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/ahmadnassri"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "node",
    "package",
    "updates",
    "check",
    "dependencies",
    "outdated"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "lib",
    "index.js"
  ],
  "bin": "index.js",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ci": "bun test",
    "build": "bun run build:all",
    "build:all": "bun run build:linux && bun run build:macos-arm && bun run build:macos-x64 && bun run build:windows",
    "build:linux": "bun build --compile --target=bun-linux-x64 ./index.js --outfile dist/updated-linux-x64",
    "build:macos-arm": "bun build --compile --target=bun-darwin-arm64 ./index.js --outfile dist/updated-darwin-arm64",
    "build:macos-x64": "bun build --compile --target=bun-darwin-x64 ./index.js --outfile dist/updated-darwin-x64",
    "build:windows": "bun build --compile --target=bun-windows-x64 ./index.js --outfile dist/updated-windows-x64.exe"
  },
  "dependencies": {
    "npm-registry-fetch": "^17.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.3.7",
    "yaml": "^2.3.4"
  }
}
